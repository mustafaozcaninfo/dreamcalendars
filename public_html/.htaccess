ErrorDocument 404 /404.php
<IfModule mod_headers.c>
    Header set Connection keep-alive
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "public, max-age=86400, s-maxage=86400"
        Header set Cloudflare-CDN-Cache-Control "max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|webp|avif|pdf)$">
        Header set Cache-Control "public, max-age=604800, s-maxage=604800"
    </FilesMatch>
</IfModule>
## EXPIRES CACHING ##
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/pdf "access plus 1 month"
ExpiresByType text/x-javascript "access plus 1 month"
ExpiresByType application/x-shockwave-flash "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresDefault "access plus 7 days"
</IfModule>
## EXPIRES CACHING ##
Options -Indexes
Options +FollowSymLinks
RewriteEngine on
RewriteBase /
# Canonical host: apex -> www
RewriteCond %{HTTP_HOST} ^dreamcalendars\.com$ [NC]
RewriteRule ^ https://www.dreamcalendars.com%{REQUEST_URI} [R=301,L]

RewriteRule ^holidays/?$ /holidays/%{TIME_YEAR} [R=301,L]
RewriteRule ^week-numbers/?$ /week-numbers/%{TIME_YEAR} [R=301,L]
RewriteRule ^pages/(.*)$ page.php?page=$1 [L,NC]
RewriteRule ^when-is/(.*)$ when-is.php?page=$1 [L,NC]
RewriteRule ^article/(.*)$ article.php?article=$1 [L,NC]
RewriteRule ^translate/(.*)$ translate.php?article=$1 [L,NC]
RewriteRule ^download/(.*)/(.*)/(.*)/(.*)$ download.php?cat=$1&year=$2&month=$3&file=$4 [L,NC]
RewriteRule ^download/(.*)/(.*)/(.*)$ download.php?cat=$1&year=$2&file=$3 [L,NC]
RewriteRule ^download/(.*)/(.*)$ download.php?cat=$1&file=$2 [L,NC]
RewriteRule ^calendar/(.*)-([0-9]+)$ month.php?month=$1&year=$2 [L,NC]
RewriteRule ^calendar/blank$ blank-calendar.php [L,NC]
RewriteRule ^calendar/([0-9]+)$ year.php?year=$1 [L,NC]
RewriteRule ^leap-years$ leap-years.php [L,NC]
RewriteRule ^daylight-saving-time$ daylight-saving-time.php [L,NC]
RewriteRule ^todays-moon-phase$ current-moon.php [L,NC]
RewriteRule ^make/(.*)-([0-9]+)$ editor.php?month=$1&year=$2 [L,NC]
RewriteRule ^holidays/([0-9]+)$ holidays.php?year=$1 [L,NC]
RewriteRule ^day-numbers/([0-9]+)$ day-numbers.php?year=$1 [L,NC]
RewriteRule ^week-numbers/([0-9]+)/?$ week-numbers.php?y=$1 [L,NC]
RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]
RewriteRule ^sitemap-(core|calendars|holidays|articles)\.xml$ sitemap.php?segment=$1 [L,NC]
RewriteRule ^calendar-download$ /calendar-download.php [L]
<ifModule mod_gzip.c>
mod_gzip_on Yes
mod_gzip_dechunk Yes
mod_gzip_item_include file .(html?|txt|css|js|php|pl)$
mod_gzip_item_include handler ^cgi-script$
mod_gzip_item_include mime ^text/.*
mod_gzip_item_include mime ^application/x-javascript.*
mod_gzip_item_exclude mime ^image/.*
mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</ifModule>
