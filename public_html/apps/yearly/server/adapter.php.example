# ACTION
$keys = isset($_REQUEST['keys'])?$_REQUEST['keys']:array();
if (!is_array($keys)){
	$keys = array($keys);
}
$keys = array_filter($keys);



# RESULT
$unavailable = array();
if (!empty($keys)){
	$sql = "SELECT * FROM holidays WHERE DATE_FORMAT(holidaydate, '%Y-%m') IN ('".implode("', '", $keys)."')";

//$sql = "SELECT * FROM holidays where DATE_FORMAT(holidaydate, '%Y-%m')  ";

	$stmt = $db->query($sql);


        while ($row = $stmt->fetch()) {

     	$unavailable[] = date("Y-m-d", $row['holidaydate']);;
}

}
echo(json_encode($unavailable));
